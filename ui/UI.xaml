<!--
    UI.xaml — finestra principale di WinGet Studio.

    Caricato da App.Bootstrap.ps1: se questo file esiste accanto allo script/exe vince
    su quello embeddato, quindi si puo' ritoccare la UI e rilanciare senza ricompilare.
    build.ps1 lo inietta nell'exe per mantenerlo single-file.

    Struttura: TabControl con una scheda per area funzionale; barra di avanzamento e log
    stanno FUORI dalle schede, in fondo alla finestra, e sono condivisi da tutte.

    I colori arrivano da Theme.Light.xaml / Theme.Dark.xaml, montati a runtime in
    Resources.MergedDictionaries. Usare SEMPRE {DynamicResource ...} per i colori:
    StaticResource si risolve una volta sola e non seguirebbe il cambio tema.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinGet Studio" Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" MinWidth="760" MinHeight="520"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}">

    <Window.Resources>
        <!-- Cosa mostra la striscia dei tab: le riscrive Set-TabHeaderStyle, qui ci sono i
             valori di partenza (Icon + Text). Sono Visibility e non colori, quindi NON stanno
             nei file di tema — il controllo sulle chiavi guarda solo quelle che finiscono in
             "Brush". Vivono nelle Resources della finestra, che Set-Theme non tocca: quel
             metodo svuota solo i MergedDictionaries. -->
        <Visibility x:Key="TabIconVis">Visible</Visibility>
        <Visibility x:Key="TabTextVis">Visible</Visibility>

        <!-- Spinner riutilizzabile: 8 punti con opacita' decrescente, rotazione a
             8 step in 1s (equivalente WPF dell'esempio CSS). -->
        <Style x:Key="Spinner" TargetType="Control">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Viewbox>
                            <Canvas Width="48" Height="48">
                                <Canvas.RenderTransform>
                                    <RotateTransform CenterX="24" CenterY="24" Angle="0"/>
                                </Canvas.RenderTransform>
                                <!-- Animazione auto-targettata (nessun TargetName: evita la
                                     risoluzione nella namescope del template, che fallisce). -->
                                <Canvas.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimationUsingKeyFrames
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        Duration="0:0:1">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.125" Value="45"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.250" Value="90"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.375" Value="135"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.500" Value="180"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.625" Value="225"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.750" Value="270"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.875" Value="315"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.000" Value="360"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Canvas.Triggers>
                                <Ellipse Canvas.Left="35.5" Canvas.Top="20.5" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="1.0"/>
                                <Ellipse Canvas.Left="31.1" Canvas.Top="31.1" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.85"/>
                                <Ellipse Canvas.Left="20.5" Canvas.Top="35.5" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.7"/>
                                <Ellipse Canvas.Left="9.9"  Canvas.Top="31.1" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.55"/>
                                <Ellipse Canvas.Left="5.5"  Canvas.Top="20.5" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.4"/>
                                <Ellipse Canvas.Left="9.9"  Canvas.Top="9.9"  Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.3"/>
                                <Ellipse Canvas.Left="20.5" Canvas.Top="5.5"  Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.2"/>
                                <Ellipse Canvas.Left="31.1" Canvas.Top="9.9"  Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.12"/>
                            </Canvas>
                        </Viewbox>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pulsanti: template minimo. Quello di sistema (Aero2) ha hover/pressed cablati
             su gradienti chiari e in Dark-Mode tornerebbe azzurro sotto il mouse. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CtrlBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CtrlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CtrlPressBrush}"/>
                            </Trigger>
                            <!-- Disabilitato: testo in tono minore, bordo e sfondo INTATTI.
                                 Prima era Opacity 0.5 su tutto il bordo, che su un filo gia'
                                 debole lo faceva sparire: un pulsante spento diventava
                                 indistinguibile da un pulsante assente. Il colore del testo
                                 e' il segnale, la cornice resta a dire che il pulsante c'e'. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource SubtleFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Maniglia di ridimensionamento colonna: invisibile, larga 8px, cursore SizeWE.
             Va nel template dell'header con i nomi PART_*HeaderGripper esatti, altrimenti
             DataGrid non la aggancia e le colonne restano fisse. -->
        <Style x:Key="ColumnGripper" TargetType="Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header DataGrid: anche qui template minimo, DataGridHeaderBorder di sistema
             disegna il gradiente Aero e ignora Background. Attenzione: ri-templare l'header
             butta via i due Thumb del template di sistema, cioe' proprio cio' che permette
             di trascinare il bordo colonna -> vanno rimessi a mano. -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,6"/>
            <!-- Intestazioni SEMPRE centrate, anche sopra colonne il cui contenuto e'
                 allineato a sinistra: sono etichette della colonna, non del testo.
                 I nomi si scrivono in MAIUSCOLO direttamente negli Header: WPF non ha un
                 equivalente di text-transform e un converter per questo sarebbe sproporzionato. -->
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{DynamicResource HeaderBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush2}"
                                    BorderThickness="0,0,1,1">
                                <!-- HorizontalAlignment legato a HorizontalContentAlignment:
                                     senza questo binding la proprieta' non arriva al
                                     contenuto e le intestazioni resterebbero a sinistra
                                     qualunque cosa dica lo stile. -->
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"  HorizontalAlignment="Left"
                                   Style="{StaticResource ColumnGripper}"/>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Style="{StaticResource ColumnGripper}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Il template di sistema (Aero2) disegna la spunta con un colore FISSO scuro
             (OptionMark.Static.Glyph = #FF212121): sul quadratino scuro del tema Dark
             era invisibile, e nessun Setter dall'esterno puo' cambiarlo perche' e' una
             StaticResource interna al dizionario di tema. Quindi template minimo:
             cornice + spunta che segue FgBrush (bianca in Dark, scura in Light).
             Il ContentPresenter serve alla CheckBox "Unknown", che ha un'etichetta;
             nelle celle della griglia il contenuto e' vuoto e non occupa spazio. -->
        <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
            <Setter Property="Background" Value="{DynamicResource CtrlBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1">
                                <Path x:Name="Mark" Visibility="Collapsed"
                                      Data="M 3,7.5 L 6,10.5 L 11,3.5"
                                      Stretch="None" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Griglia in sola lettura = coda in corso: la spunta e' gia' bloccata da
                     IsReadOnly, ma senza questo continua a SEMBRARE cliccabile. Il trigger sta
                     nello stile e non nel codice, cosi' vale per tutte e tre le griglie senza
                     ripeterlo scheda per scheda. Fuori da una griglia (Unknown, MS Store) e
                     l'antenato non esiste: il binding torna null e non succede niente. -->
                <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Schede. Come per Button e DataGridColumnHeader il template di sistema (Aero2)
             disegna gradienti chiari cablati e ignora Background: in Dark-Mode le linguette
             sarebbero bianche col testo bianco. Quindi template minimo per entrambi.
             HeaderPanel con Margin inferiore -1: il bordo basso della linguetta attiva
             copre quello alto del contenuto, cosi' i due si fondono. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource BgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- IsItemsHost: e' qui che il TabControl mette le linguette.
                                 DockPanel e NON TabPanel: TabPanel le dispone in fila e non sa
                                 fissarne una a destra. Con un DockPanel i tre tab funzionali
                                 prendono il Dock di default (Left) e restano in ordine di
                                 dichiarazione, mentre il tab Settings dichiara Dock="Right".
                                 LastChildFill="False" e' OBBLIGATORIO: l'ultimo figlio di un
                                 DockPanel riempie lo spazio residuo IGNORANDO il proprio Dock,
                                 quindi senza questo il tab Settings si allargherebbe su tutta
                                 la striscia. -->
                            <DockPanel Grid.Row="0" Panel.ZIndex="1" IsItemsHost="True"
                                       LastChildFill="False" Margin="0,0,0,-1" Background="Transparent"/>
                            <!-- CornerRadius: ENTRAMBI gli angoli superiori quadrati, perche' su
                                 entrambi i lati della striscia c'e' una linguetta. A sinistra lo
                                 era gia' (la prima scheda ci si fonde sopra); a destra il raggio
                                 di 4 era rimasto da quando lassu' non c'era nulla, e sotto il tab
                                 Settings affiorava come uno scalino. -->
                            <Border Grid.Row="1" BorderThickness="1" CornerRadius="0,0,4,4"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <!-- PART_SelectedContentHost: nome richiesto da TabControl per
                                     mostrare il contenuto della scheda attiva. -->
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" Margin="8"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SubtleFgBrush}"/>
            <!-- Header: icona + parola, e cosa si vede lo decide l'utente da Settings.
                 Il glifo viene da Tag della linguetta, quindi c'e' UN solo template per tutti
                 i tab e aggiungerne uno costa due attributi invece di un header a mano.
                 Header resta la stringa: e' il nome accessibile, ed e' su quello che i
                 controlli sull'ordine dei tab si appoggiano.
                 I 7px di stacco stanno sull'ICONA e non sulla parola: un elemento Collapsed
                 non occupa spazio, margine compreso, quindi in modalita' Text lo stacco
                 sparisce da solo. Un trigger non servirebbe — e non funzionerebbe: il Binding
                 di un DataTrigger non accetta un DynamicResource.
                 AutomationProperties.Name vuoto sul glifo: il nome lo porta la linguetta. -->
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <!-- MinHeight: senza, in modalita' solo icona la linguetta si
                             ACCORCIAVA di 2px, perche' il riquadro di riga del glifo e' piu'
                             basso di quello del testo e con la parola collassata restava solo
                             lui. 16 e' l'altezza che il testo occupa da solo, quindi la
                             striscia resta identica nelle tre modalita'. -->
                        <StackPanel Orientation="Horizontal" MinHeight="16">
                            <!-- Lo stacco fra icona e parola sta sulla PAROLA, e il glifo non ha
                                 margini: cosi' in sola icona e' esattamente al centro della
                                 linguetta, ed e' la modalita' in cui uno scarto si vede (la
                                 linguetta e' larga la meta').
                                 In sola testo la parola resta 3,5px a destra del centro, perche'
                                 il suo margine sinistro sopravvive all'icona collassata: su una
                                 linguetta larga il triplo non si distingue, e le alternative
                                 costano un DataTrigger che non puo' leggere un DynamicResource
                                 oppure una Thickness nelle risorse, che fa fallire il layout. -->
                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center"
                                       AutomationProperties.Name=""
                                       Visibility="{DynamicResource TabIconVis}"/>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="7,0,0,0"
                                       Visibility="{DynamicResource TabTextVis}"/>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <!-- Il ToolTip della linguetta sta QUI e non sul TabItem. WPF cerca il
                             tooltip risalendo anche l'albero LOGICO, e nell'albero logico il
                             padre del contenuto di una scheda e' il TabItem stesso: con il
                             ToolTip sul TabItem, ogni controllo della pagina che non ne aveva
                             uno proprio mostrava quello della linguetta (verificato a finestra
                             aperta: cursore sul pulsante Check for updates, tooltip aperto con
                             PlacementTarget = TabItem[TabSettings]). Il Border del template
                             copre tutta la linguetta e non e' antenato del contenuto, quindi il
                             tooltip resta dove serve e non cola nella pagina. Il testo vive in
                             AutomationProperties.HelpText della linguetta, che e' anche il posto
                             giusto per uno screen reader. -->
                        <Border x:Name="bd" Margin="0,0,2,0" CornerRadius="4,4,0,0"
                                BorderThickness="1,1,1,0"
                                ToolTip="{Binding Path=(AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}"
                                Background="{DynamicResource CtrlBgBrush}"
                                BorderBrush="{DynamicResource CtrlBorderBrush}">
                            <!-- 9px per lato contro i 7 di stacco fra icona e parola: prima erano
                                 14 per lato contro 4 in mezzo, e la linguetta sembrava due cose
                                 lontane dentro una scatola larga. -->
                            <ContentPresenter ContentSource="Header" Margin="9,6"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Attiva: stesso sfondo del contenuto (continuita') e testo pieno. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CtrlHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cella "Result": spinner mentre l'operazione gira, poi un glifo colorato.
             Sta qui come risorsa perche' la usano tutte le griglie (Updates, Install e
             le prossime), sempre identica. -->
        <DataTemplate x:Key="ResultCell">
            <Grid HorizontalAlignment="Center">
                <Control x:Name="cellSpinner" Width="18" Height="18"
                         Style="{StaticResource Spinner}" Visibility="Collapsed"/>
                <!-- Icone di stato dal set di sistema di Windows 11 (fallback a
                     Segoe MDL2 Assets su Win10): forme PIENE e distinte fra loro,
                     leggibili anche senza distinguere i colori. Niente FontWeight:
                     un icon font in Bold viene ingrassato per sintesi e sbava.
                     AutomationProperties.Name lo scrivono i DataTrigger insieme al glifo:
                     senza, uno screen reader leggerebbe il codepoint del carattere. -->
                <!-- Il ToolTip sta sul GLIFO e non sulla Grid della cella: la Grid c'e'
                     sempre, e Start-WinGetQueue azzera StatusDetail a stringa VUOTA, che per WPF
                     non e' "nessun tooltip" ma "tooltip vuoto". Risultato: un rettangolino
                     vuoto che si apriva passando sulla colonna Result di qualunque riga
                     senza esito. Un elemento Collapsed non riceve il mouse, quindi con il
                     tooltip qui compare solo quando c'e' davvero un esito da spiegare. -->
                <TextBlock x:Name="cellIcon" FontSize="16"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           ToolTip="{Binding StatusDetail}"
                           AutomationProperties.Name="No result yet"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="updating">
                    <Setter TargetName="cellSpinner" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <!-- EC61 CompletedSolid: cerchio pieno con spunta bianca -->
                <DataTrigger Binding="{Binding Status}" Value="ok">
                    <Setter TargetName="cellIcon" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="cellIcon" Property="Text" Value="&#xEC61;"/>
                    <Setter TargetName="cellIcon" Property="AutomationProperties.Name" Value="Succeeded"/>
                    <Setter TargetName="cellIcon" Property="Foreground" Value="{DynamicResource OkBrush}"/>
                </DataTrigger>
                <!-- EB90 StatusErrorFull: cerchio pieno con X bianca -->
                <DataTrigger Binding="{Binding Status}" Value="error">
                    <Setter TargetName="cellIcon" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="cellIcon" Property="Text" Value="&#xEB90;"/>
                    <Setter TargetName="cellIcon" Property="AutomationProperties.Name" Value="Failed"/>
                    <Setter TargetName="cellIcon" Property="Foreground" Value="{DynamicResource ErrBrush}"/>
                </DataTrigger>
                <!-- E814 IncidentTriangle: triangolo pieno con ! bianco -->
                <DataTrigger Binding="{Binding Status}" Value="warning">
                    <Setter TargetName="cellIcon" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="cellIcon" Property="Text" Value="&#xE814;"/>
                    <Setter TargetName="cellIcon" Property="AutomationProperties.Name" Value="Finished with a warning"/>
                    <Setter TargetName="cellIcon" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Cella "Pin": E718 (Pin), presente sia in Segoe Fluent Icons sia in Segoe MDL2
             Assets — Test-Ui.ps1 verifica nei font che ogni glifo usato qui esista, cosi'
             un codice sbagliato non finisce a video come quadratino. -->
        <DataTemplate x:Key="PinCell">
            <TextBlock x:Name="pinIcon" FontSize="13" Text="&#xE718;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"
                       AutomationProperties.Name="Pinned"
                       ToolTip="Pinned: winget will not upgrade it until the pin is removed"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                    <Setter TargetName="pinIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Spunta delle griglie: come ThemedCheckBox, ma spenta sulle righe con un pin.
             Non basta come presidio (Select all lavora sugli oggetti, non sulla UI), ma
             rende visibile subito che quella riga non si tocca. Stile separato perche' le
             spunte fuori griglia non hanno una riga sotto e non c'e' nulla da leggere. -->
        <Style x:Key="PinnableCheckBox" TargetType="CheckBox" BasedOn="{StaticResource ThemedCheckBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <!-- Ripetuto e non ereditato: BasedOn porta con se' i Setter, e su una cosa
                     che si nota solo guardando lo schermo preferisco non affidarmi
                     all'ereditarieta' dei Trigger. Tre righe, zero dubbi. -->
                <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tooltip: stessa storia del menu contestuale. Aero2 lo disegna bianco con testo
             nero, quindi in tema scuro era un rettangolo chiaro in mezzo alla pagina. Stesse
             chiavi del menu contestuale, cosi' i due riquadri che si aprono sopra la pagina si
             somigliano. HasDropShadow spento: l'ombra la disegna il tema di sistema e resta
             chiara comunque.
             Un TextBlock e non un ContentPresenter perche' serve TextWrapping: il tooltip piu'
             lungo (quello del controllo aggiornamenti all'avvio) e' una riga da oltre 500px che
             usciva dallo schermo, e TextWrapping non e' una proprieta' ereditata, quindi su un
             ContentPresenter non si puo' imporre. Tutti i tooltip di questa interfaccia sono
             stringhe; se un domani ne servisse uno con dentro dei controlli, qui va un
             ContentPresenter e il capo a riga si risolve altrimenti. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource CtrlBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap"
                                       MaxWidth="360" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu contestuale: quello di sistema (Aero2) disegna sfondo chiaro e testo nero,
             quindi in Dark-Mode sarebbe illeggibile. Template minimo, come per i pulsanti. -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource CtrlBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="2">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- IsHighlighted, non IsMouseOver: e' la proprieta' che il menu
                                 usa anche per la navigazione da tastiera. -->
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CtrlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource SubtleFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Voce del menu a tendina: il template di sistema evidenzia in azzurro fisso. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CtrlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu a tendina. Va ri-templato per intero: quello di sistema (Aero2) disegna
             sfondo e bordo con colori cablati e in Dark-Mode resta bianco.
             Struttura minima che ComboBox richiede: un ToggleButton legato a
             IsDropDownOpen e un Popup di nome PART_Popup. Il ToggleButton e' trasparente e
             sta SOPRA il bordo, cosi' intercetta il clic su tutta la superficie senza
             doverne annidare il template dentro quello della ComboBox. -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CtrlBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorderBrush}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="4" BorderThickness="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <Grid>
                                    <ContentPresenter Margin="8,0,26,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <!-- Freccia disegnata a mano: un glifo di font qui
                                         costringerebbe a gestire il fallback dell'icona. -->
                                    <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,9,0" Data="M 0,0 L 4.5,4.5 L 9,0"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                <Border Background="{DynamicResource CtrlBgBrush}"
                                        BorderBrush="{DynamicResource CtrlBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="2"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cursore della barra di scorrimento: un rettangolo arrotondato che schiarisce
             sotto il mouse e mentre si trascina. Margin 2: lascia un filo di traccia
             visibile ai lati, come fa Windows 11. -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bd" CornerRadius="4" Margin="2"
                                Background="{DynamicResource CtrlBorderBrush}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleFgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra di scorrimento. Come CheckBox, header e ComboBox: il template di sistema
             (Aero2) cabla colori chiari e ignora Background, quindi in Dark-Mode le barre
             restavano BIANCHE, ed erano l'ultimo pezzo della finestra a non seguire il tema.
             Template minimo: traccia + cursore, senza i pulsanti freccia (Windows 11 non li
             disegna piu'). I due RepeatButton dentro il Track restano, trasparenti: sono loro
             che fanno avanzare di una pagina quando si clicca nel vuoto della traccia, e senza
             di loro quel clic non farebbe nulla.
             PART_Track e' il nome che ScrollBar cerca per calcolare la posizione del cursore:
             rinominarlo blocca la barra senza alcun errore.
             IsDirectionReversed="True" e' la forma VERTICALE (il valore cresce verso il basso);
             il trigger su Orientation lo toglie e scambia gli assi. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource CtrlBgBrush}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width"     Value="Auto"/>
                                <Setter Property="MinWidth"  Value="0"/>
                                <Setter Property="Height"    Value="12"/>
                                <Setter Property="MinHeight" Value="12"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titolo di sezione nella scheda Settings: piu' piccolo e in tono minore delle
             etichette che introduce. Con lo stesso peso del testo sotto non separava niente. -->
        <Style x:Key="SettingsHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleFgBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Campo di testo: la TextBox di sistema ha sfondo bianco cablato e in Dark-Mode
             resterebbe bianca col testo bianco. Serve solo impostare i colori. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CtrlBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource CtrlBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CtrlBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                            <Grid>
                                <!-- PART_Track / PART_Indicator: nomi richiesti da ProgressBar
                                     per calcolare la larghezza dell'indicatore. -->
                                <Rectangle x:Name="PART_Track"/>
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Layout: le schede occupano tutto lo spazio elastico; barra di avanzamento e log
         stanno FUORI dal TabControl, in fondo, e sono condivisi da ogni scheda. -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>      <!-- 0 schede -->
            <RowDefinition Height="Auto"/>   <!-- 1 progress -->
            <RowDefinition Height="Auto"/>   <!-- 2 log label -->
            <RowDefinition Height="140"/>    <!-- 3 log -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TabControl x:Name="TabMain">
                <TabItem x:Name="TabInstall" Header="Install" Tag="&#xE896;"
                         AutomationProperties.Name="Install"
                         AutomationProperties.HelpText="Search the winget catalogue as you type and install what you pick">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- ricerca -->
                            <RowDefinition Height="*"/>      <!-- risultati -->
                            <RowDefinition Height="Auto"/>   <!-- action bar -->
                        </Grid.RowDefinitions>

                        <!-- Barra di ricerca, tutto allineato a sinistra in fila. StackPanel e non
                             DockPanel: con un campo a larghezza fissa non serve nulla che si
                             allarghi, e lo spinner in coda puo' comparire e sparire senza
                             spostare niente. Prima, agganciato a destra, comparendo rubava 20px
                             al campo di ricerca. -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <!-- Il campo e il suo testo guida sovrapposto: WPF non ha un
                                 placeholder nativo, quindi e' un TextBlock non cliccabile che
                                 compare solo a campo vuoto. -->
                            <Grid Width="380">
                                <TextBox x:Name="TxtSearch" Height="26" VerticalContentAlignment="Center"/>
                                <TextBlock Text="Package name or ID, at least 3 characters"
                                           IsHitTestVisible="False" Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtleFgBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button x:Name="BtnSearch" Content="Search" Width="104" Height="26" Margin="8,0,0,0"/>
                            <!-- Spunta ON = interroga anche il Microsoft Store. Vale solo per la
                                 ricerca lanciata con Invio o col pulsante: msstore va in rete
                                 (~5s misurati) e non regge l'aggiornamento a ogni tasto.
                                 Accanto a Search perche' ne modifica il comportamento. -->
                            <CheckBox x:Name="ChkStore" IsChecked="False"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      Content="MS Store" Style="{StaticResource ThemedCheckBox}"
                                      ToolTip="Also search the Microsoft Store. Slower (goes online), so it only applies when you press Enter or the Search button"
                                      Foreground="{DynamicResource FgBrush}"/>
                            <Control x:Name="SearchSpinner" Width="20" Height="20" Style="{StaticResource Spinner}"
                                     Margin="12,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Risultati della ricerca: stessa struttura e stessi stili della griglia
                             degli aggiornamenti, senza la colonna "Available". -->
                        <DataGrid x:Name="GridSearch" Grid.Row="1"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  IsReadOnly="False" SelectionMode="Extended"
                                  Background="{DynamicResource BgBrush}"
                                  Foreground="{DynamicResource FgBrush}"
                                  BorderBrush="{DynamicResource CtrlBorderBrush}"
                                  RowBackground="{DynamicResource BgBrush}"
                                  AlternatingRowBackground="{DynamicResource RowAltBgBrush}"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush2}"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  CellStyle="{StaticResource GridCell}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="SEL." Width="46"
                                    ElementStyle="{StaticResource ThemedCheckBox}"
                                    EditingElementStyle="{StaticResource ThemedCheckBox}"
                                    Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTextColumn Header="NAME"    Width="2*"   IsReadOnly="True" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="VERSION" Width="1.2*" IsReadOnly="True" Binding="{Binding Version}"/>
                                <DataGridTextColumn Header="ID"      Width="2.4*" IsReadOnly="True" Binding="{Binding Id}"/>
                                <DataGridTemplateColumn Header="RESULT" Width="70"
                                                        CellTemplate="{StaticResource ResultCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Messaggio di stato al posto della griglia: guida iniziale, "nessun
                             risultato", ricerca troppo corta. -->
                        <TextBlock x:Name="TxtSearchEmpty" Grid.Row="1"
                                   Text="Type a package name to search the winget catalog."
                                   FontSize="16" Foreground="{DynamicResource SubtleFgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"/>

                        <DockPanel Grid.Row="2" Margin="0,8,0,0">
                            <!-- Ambito di installazione, accanto al pulsante che lo usa. Pulsante
                                 ciclico Auto -> User -> Machine invece di una ComboBox: il template
                                 di sistema della ComboBox va riscritto per intero per il tema
                                 scuro, un pulsante no. Testo e ToolTip li scrive Tab.Install.ps1. -->
                            <Button x:Name="BtnScope" Width="124" Height="26" DockPanel.Dock="Left"/>
                            <Button x:Name="BtnInstall" Content="Install" Width="104" Height="26"
                                    DockPanel.Dock="Left" Margin="8,0,0,0" IsEnabled="False"/>
                            <TextBlock x:Name="TxtSearchInfo" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource SubtleFgBrush}"/>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TabInstalled" Header="Installed" Tag="&#xE71D;"
                         AutomationProperties.Name="Installed"
                         AutomationProperties.HelpText="Everything installed on this machine: filter it, pin it, uninstall it">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- comandi e filtro -->
                            <RowDefinition Height="*"/>      <!-- elenco -->
                            <RowDefinition Height="Auto"/>   <!-- action bar -->
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnRefreshInstalled" Content="Refresh" Width="104" Height="26"/>
                            <!-- Filtro locale sull'elenco gia' caricato: non richiama winget.
                                 Con qualche centinaio di pacchetti installati (misurati: 339 su
                                 questa macchina) scorrere a mano non e' praticabile. -->
                            <Grid Width="300" Margin="8,0,0,0">
                                <TextBox x:Name="TxtFilter" Height="26" VerticalContentAlignment="Center"/>
                                <TextBlock Text="Filter by name or ID"
                                           IsHitTestVisible="False" Margin="7,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubtleFgBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtFilter}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Control x:Name="InstalledSpinner" Width="20" Height="20" Style="{StaticResource Spinner}"
                                     Margin="12,0,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtInstalledCount" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
                        </StackPanel>

                        <DataGrid x:Name="GridInstalled" Grid.Row="1"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  IsReadOnly="False" SelectionMode="Extended"
                                  Background="{DynamicResource BgBrush}"
                                  Foreground="{DynamicResource FgBrush}"
                                  BorderBrush="{DynamicResource CtrlBorderBrush}"
                                  RowBackground="{DynamicResource BgBrush}"
                                  AlternatingRowBackground="{DynamicResource RowAltBgBrush}"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush2}"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  CellStyle="{StaticResource GridCell}">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="MenuPinInstalled"   Header="Pin highlighted (block upgrades)"/>
                                    <MenuItem x:Name="MenuUnpinInstalled" Header="Remove pin from highlighted"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <!-- Qui la spunta resta attiva anche sui pacchetti pinnati: un pin
                                     blocca gli AGGIORNAMENTI, non la disinstallazione. -->
                                <DataGridCheckBoxColumn Header="SEL." Width="46"
                                    ElementStyle="{StaticResource ThemedCheckBox}"
                                    EditingElementStyle="{StaticResource ThemedCheckBox}"
                                    Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTemplateColumn Header="PIN" Width="42"
                                                        CellTemplate="{StaticResource PinCell}"/>
                                <DataGridTextColumn Header="NAME"    Width="2*"   IsReadOnly="True" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="VERSION" Width="1.2*" IsReadOnly="True" Binding="{Binding Version}"/>
                                <DataGridTextColumn Header="ID"      Width="2.4*" IsReadOnly="True" Binding="{Binding Id}"/>
                                <DataGridTemplateColumn Header="RESULT" Width="70"
                                                        CellTemplate="{StaticResource ResultCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="TxtInstalledEmpty" Grid.Row="1"
                                   Text="Press Refresh to list the installed packages."
                                   FontSize="16" Foreground="{DynamicResource SubtleFgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"/>

                        <DockPanel Grid.Row="2" Margin="0,8,0,0">
                            <Button x:Name="BtnUninstall" Content="Uninstall" Width="104" Height="26"
                                    DockPanel.Dock="Left" IsEnabled="False"/>
                            <!-- Export/Import a destra, staccati da Uninstall: agiscono sulla
                                 macchina intera, non sulle righe selezionate. -->
                            <Button x:Name="BtnImport" Content="Import..." Width="104" Height="26"
                                    DockPanel.Dock="Right" Margin="8,0,2,0"
                                    ToolTip="Install the packages listed in a .json file exported from winget"/>
                            <Button x:Name="BtnExport" Content="Export..." Width="104" Height="26"
                                    DockPanel.Dock="Right"
                                    ToolTip="Save the list of installed packages to a .json file"/>
                            <TextBlock x:Name="TxtInstalledInfo" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource SubtleFgBrush}"/>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- IsSelected: l'ordine dei tab e' alfabetico, ma la vista di apertura resta
                     Updates — la scansione lanciata da Add_ContentRendered popola proprio
                     questa, e aprire su un tab che nessuno guarda nasconderebbe il conteggio. -->
                <TabItem x:Name="TabUpdates" Header="Updates" Tag="&#xE777;" IsSelected="True"
                         AutomationProperties.Name="Updates"
                         AutomationProperties.HelpText="Packages with a newer version available, and the queue that updates them">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- top bar -->
                            <RowDefinition Height="*"/>      <!-- elenco -->
                            <RowDefinition Height="Auto"/>   <!-- action bar -->
                        </Grid.RowDefinitions>

                        <!-- Top bar della scheda: ricerca aggiornamenti + conteggio -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <!-- "Check" e non "Check for updates": la scheda si chiama gia'
                                 Updates. Larghezza uguale agli altri pulsanti della scheda. -->
                            <Button x:Name="BtnRefresh" Content="Check" Width="104" Height="26" DockPanel.Dock="Left"/>
                            <!-- Spunta ON = flag include-unknown passato a "winget upgrade"; spenta di
                                 default. Foreground esplicito: la CheckBox di sistema forza il testo nero e
                                 in Dark-Mode sparirebbe. Ha effetto alla ricerca successiva. -->
                            <CheckBox x:Name="ChkUnknown" DockPanel.Dock="Left" IsChecked="False"
                                      VerticalAlignment="Center" Margin="10,0,0,0"
                                      Content="Unknown" Style="{StaticResource ThemedCheckBox}"
                                      ToolTip="Pass --include-unknown to winget: also list packages whose installed version winget cannot determine"
                                      Foreground="{DynamicResource FgBrush}"/>
                            <Control x:Name="TopSpinner" Width="20" Height="20" Style="{StaticResource Spinner}"
                                     DockPanel.Dock="Left" Margin="10,0,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtAvailable" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
                        </DockPanel>

                        <!-- Tabella upgrade -->
                        <DataGrid x:Name="Grid" Grid.Row="1"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  IsReadOnly="False" SelectionMode="Extended"
                                  Background="{DynamicResource BgBrush}"
                                  Foreground="{DynamicResource FgBrush}"
                                  BorderBrush="{DynamicResource CtrlBorderBrush}"
                                  RowBackground="{DynamicResource BgBrush}"
                                  AlternatingRowBackground="{DynamicResource RowAltBgBrush}"
                                  HorizontalGridLinesBrush="{DynamicResource BorderBrush2}"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  CellStyle="{StaticResource GridCell}">
                            <!-- Pin e Unpin agiscono sulle righe EVIDENZIATE, non su quelle
                                 spuntate: la spunta di una riga pinnata e' disabilitata, quindi
                                 con le spunte il pin non si potrebbe piu' togliere. -->
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="MenuPinUpdates"   Header="Pin highlighted (block upgrades)"/>
                                    <MenuItem x:Name="MenuUnpinUpdates" Header="Remove pin from highlighted"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="SEL." Width="46"
                                    ElementStyle="{StaticResource PinnableCheckBox}"
                                    EditingElementStyle="{StaticResource PinnableCheckBox}"
                                    Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <DataGridTemplateColumn Header="PIN" Width="42"
                                                        CellTemplate="{StaticResource PinCell}"/>
                                <DataGridTextColumn Header="NAME"              Width="2*"   IsReadOnly="True" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="INSTALLED VERSION" Width="1.2*" IsReadOnly="True" Binding="{Binding Version}"/>
                                <DataGridTextColumn Header="AVAILABLE VERSION" Width="1.2*" IsReadOnly="True" Binding="{Binding Available}"/>
                                <DataGridTextColumn Header="ID"                Width="2*"   IsReadOnly="True" Binding="{Binding Id}"/>
                                <!-- Esito: spinner (in corso) oppure glyph colorato -->
                                <DataGridTemplateColumn Header="RESULT" Width="70"
                                                        CellTemplate="{StaticResource ResultCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Messaggio "nessun aggiornamento" (nascosto di default) -->
                        <TextBlock x:Name="TxtEmpty" Grid.Row="1"
                                   Text="No updates available."
                                   FontSize="16" Foreground="{DynamicResource SubtleFgBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>

                        <!-- Action bar: selezione + aggiorna + conteggio selezionati -->
                        <DockPanel Grid.Row="2" Margin="0,8,0,0">
                            <Button x:Name="BtnToggleAll" Content="Select all" Width="104" Height="26"
                                    DockPanel.Dock="Left" IsEnabled="False"/>
                            <Button x:Name="BtnUpdate" Content="Update" Width="104" Height="26"
                                    DockPanel.Dock="Left" Margin="8,0,0,0" IsEnabled="False"/>
                            <TextBlock x:Name="TxtSelected" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource SubtleFgBrush}"/>
                        </DockPanel>
                    </Grid>
                </TabItem>


                <!-- Impostazioni: un tab come gli altri, fissato a destra della striscia.
                     PERCHE' NON UN OVERLAY: sovrapposto a tutta la finestra copriva barra di
                     avanzamento e log, cioe' l'unico canale che dice come sta andando
                     un'operazione, e serviva una catena di RowSpan, ZIndex, fuoco e Esc per
                     comportarsi come una schermata. Da tab non serve niente di tutto questo.
                     L'header e' glifo + parola: il testo fa anche da nome accessibile, che un
                     header di sola icona non avrebbe (uno screen reader leggerebbe il
                     codepoint). E713 (Settings) esiste in entrambi i font di sistema —
                     Test-Ui.ps1 lo verifica.
                     Nessun Foreground esplicito sui due TextBlock: cosi' ereditano quello della
                     linguetta e seguono i trigger di selezione e hover. -->
                <!-- Margine destro NEGATIVO: il template della linguetta tiene 2px di stacco a
                     destra per separarla dalla successiva, ma qui a destra non c'e' nessuna
                     successiva — c'e' il bordo del riquadro, e quei 2px lasciavano la linguetta
                     disallineata rispetto a lui. Il -2 sposta la slot di layout 2px oltre il
                     bordo del pannello, cosi' lo stacco interno cade fuori e il bordo visibile
                     della linguetta finisce esattamente sul bordo del riquadro. -->
                <!-- ORDINE DI DICHIARAZIONE E POSIZIONE NON COINCIDONO: in un DockPanel il
                     PRIMO figlio con Dock="Right" prende il bordo destro e il successivo si
                     mette alla sua sinistra. About e' dichiarato prima di Settings perche' e'
                     lui a stare piu' a destra.
                     Il margine destro negativo sta quindi su About: recupera i 2px di stacco
                     che il template tiene a destra di ogni linguetta e che sull'ultima la
                     lasciavano disallineata dal riquadro. -->
                <TabItem x:Name="TabAbout" Header="About" Tag="&#xE946;"
                         DockPanel.Dock="Right" Margin="0,0,-2,0"
                         AutomationProperties.Name="About"
                         AutomationProperties.HelpText="What this app does, where to report a bug, and the licence">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- ABOUT. Le cinque funzioni stanno in una TABELLA SENZA BORDI: una Grid
                             a due colonne, nome a sinistra e descrizione a destra. In un blocco di
                             prosa unico i nomi finivano in mezzo alle frasi e l'occhio non trovava
                             dove comincia una funzione e dove finisce l'altra.
                             Colonna dei nomi Auto: larga quanto il nome piu' lungo e non un pixel
                             di piu', cosi' le descrizioni partono tutte dalla stessa ascissa.
                             Colonna delle descrizioni elastica: prende tutto il resto. Una cella
                             che va a capo rientra sotto la propria descrizione e non sotto il
                             nome, ed e' il motivo per cui qui il ritorno a capo non e' un
                             problema mentre nella prosa libera lo e'.
                             Nomi in FgBrush e descrizioni in SubtleFgBrush: la gerarchia la fa il
                             tono, non un bordo.
                             La nota finale su Claude Code e' volontaria: l'articolo 50 dell'AI Act
                             riguarda i sistemi AI e i contenuti generati, non gli strumenti con
                             cui si scrive il codice, e questo programma non contiene nessun
                             sistema AI. Sta qui perche' e' vero. -->
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SubtleFgBrush}"
                                       Text="WinGet Studio is a desktop front end for winget, the Windows package manager."/>

                            <Grid x:Name="AboutTable" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Updates" FontWeight="SemiBold"
                                           Margin="0,0,14,8" Foreground="{DynamicResource FgBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource SubtleFgBrush}">
                                    List what has a newer version and upgrade the packages you tick, one at a time.<LineBreak/>
                                    A running queue can be stopped: the package in progress finishes, the rest are left alone.
                                </TextBlock>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Install" FontWeight="SemiBold"
                                           Margin="0,0,14,8" Foreground="{DynamicResource FgBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource SubtleFgBrush}"
                                           Text="Search the winget catalogue as you type, optionally the Microsoft Store, and pick the install scope."/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Installed" FontWeight="SemiBold"
                                           Margin="0,0,14,8" Foreground="{DynamicResource FgBrush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource SubtleFgBrush}"
                                           Text="The inventory of the machine, with a local filter and an uninstall behind a confirmation."/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Pin" FontWeight="SemiBold"
                                           Margin="0,0,14,8" Foreground="{DynamicResource FgBrush}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource SubtleFgBrush}"
                                           Text="Block a package from being upgraded, from either list, until you remove the pin."/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Export / Import" FontWeight="SemiBold"
                                           Margin="0,0,14,0" Foreground="{DynamicResource FgBrush}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SubtleFgBrush}"
                                           Text="Save the package list to a .json file and rebuild a machine from it."/>
                            </Grid>

                            <TextBlock TextWrapping="Wrap" Margin="0,18,0,0"
                                       Foreground="{DynamicResource SubtleFgBrush}">
                                It runs elevated, because installing and removing software requires it.<LineBreak/>
                                No telemetry.<LineBreak/>
                                <LineBreak/>
                                Found a bug, or have an idea?
                                <!-- I link li apre l'handler in Start-App. -->
                                <Hyperlink NavigateUri="https://github.com/FedeB2160/WinGetStudio/issues"
                                           Foreground="{DynamicResource AccentBrush}">Open an issue on GitHub</Hyperlink>.<LineBreak/>
                                <Hyperlink NavigateUri="https://github.com/FedeB2160/WinGetStudio"
                                           Foreground="{DynamicResource AccentBrush}">Source code</Hyperlink> &#183;
                                <Hyperlink NavigateUri="https://github.com/FedeB2160/WinGetStudio/releases"
                                           Foreground="{DynamicResource AccentBrush}">Release notes</Hyperlink> &#183;
                                <Hyperlink NavigateUri="https://github.com/FedeB2160/WinGetStudio/blob/main/LICENSE"
                                           Foreground="{DynamicResource AccentBrush}">MIT licence</Hyperlink><LineBreak/>
                                <LineBreak/>
                                Made by <Hyperlink NavigateUri="https://github.com/FedeB2160"
                                           Foreground="{DynamicResource AccentBrush}">FedeB2160</Hyperlink>,
                                with the help of <Italic>Claude Code</Italic> (Anthropic).
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="TabSettings" Header="Settings" Tag="&#xE713;"
                         DockPanel.Dock="Right"
                         AutomationProperties.Name="Settings"
                         AutomationProperties.HelpText="Theme, tab strip, version and updates">
                    <!-- Impostazioni in colonna: sono pochi controlli e crescono in verticale.
                         ScrollViewer per non tagliarli a finestra piccola. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- Due colonne: etichette a larghezza automatica, controlli elastici.
                             Prima le etichette avevano Width="120" e la riga dei pulsanti un
                             margine sinistro dello stesso valore per fingere l'allineamento: una
                             etichetta piu' lunga rompeva tutto in silenzio.
                             Spaziatura: 10px fra le righe di una sezione, 22 fra una sezione e la
                             successiva. Le tendine sono larghe quanto serve al loro valore piu'
                             lungo invece dei 180px fissi di prima, che su "Light" erano il triplo
                             del necessario. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>   <!-- 0 APPEARANCE -->
                                <RowDefinition Height="Auto"/>   <!-- 1 tema -->
                                <RowDefinition Height="Auto"/>   <!-- 2 striscia dei tab -->
                                <RowDefinition Height="Auto"/>   <!-- 3 UPDATES -->
                                <RowDefinition Height="Auto"/>   <!-- 4 versione, pulsanti ed esito -->
                                <RowDefinition Height="Auto"/>   <!-- 5 spunta controllo all'avvio -->
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="APPEARANCE"
                                       Style="{StaticResource SettingsHeader}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Theme" Margin="0,0,14,10"
                                       VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <!-- Le voci le riempie App.Theme.ps1: sono gli stessi valori che
                                     finiscono nel registro (Light | Dark | System). -->
                                <ComboBox x:Name="CmbTheme" Width="140"/>
                                <TextBlock x:Name="TxtThemeHint" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="{DynamicResource SubtleFgBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Tab strip" Margin="0,0,14,22"
                                       VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}"/>
                            <!-- Le voci le riempie Initialize-TabHeaders: sono gli stessi valori
                                 che finiscono nel registro (Icon | Text | Icon + Text). -->
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbTabStyle" Width="140"
                                      HorizontalAlignment="Left" Margin="0,0,0,22"
                                      ToolTip="What the tabs show: the icon, the name, or both"/>

                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="UPDATES"
                                       Style="{StaticResource SettingsHeader}"/>
                            <!-- Versione, pulsanti ed esito su UNA riga, con la sua etichetta a
                                 sinistra come nelle righe di APPEARANCE. Prima erano tre righe
                                 impilate e due di quelle avevano la prima colonna vuota: la
                                 spunta e i pulsanti restavano appesi a meta' pagina, rientrati
                                 rispetto a un'etichetta che non c'era. La sezione ha due voci,
                                 non sei, quindi va letta in due righe. -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Installed version" Margin="0,0,14,10"
                                       VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtVersion" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Margin="0,0,18,0"
                                           Foreground="{DynamicResource FgBrush}"/>
                                <Button x:Name="BtnCheckUpdate" Content="Check for updates" Width="140" Height="26"/>
                                <!-- Compare solo quando una release e' piu' recente di questa.
                                     Foreground dal tema e NON "White": l'accento del tema scuro
                                     e' azzurro chiaro (#4CC2FF) e il bianco sopra faceva 2.01:1,
                                     cioe' illeggibile sul pulsante piu' importante della
                                     schermata. Test-Ui.ps1 misura la coppia. -->
                                <Button x:Name="BtnUpdateApp" Height="26" Padding="12,0" Margin="8,0,0,0"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource AccentFgBrush}"/>
                                <Control x:Name="UpdateSpinner" Width="20" Height="20" Style="{StaticResource Spinner}"
                                         Margin="10,0,0,0" Visibility="Collapsed"/>
                                <!-- TextTrimming: l'esito piu' lungo ("No release found...") non
                                     deve allargare la pagina e far comparire la barra in basso. -->
                                <TextBlock x:Name="TxtUpdateStatus" VerticalAlignment="Center" Margin="12,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SubtleFgBrush}"/>
                            </StackPanel>
                            <!-- Il controllo all'avvio e' una chiamata anonima all'API di GitHub.
                                 Acceso di default (e' il comportamento di sempre), ma si spegne:
                                 un programma che va in rete da solo deve almeno dirlo e lasciare
                                 la scelta. Il pulsante qui sopra resta sempre attivo. -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Automatic" Margin="0,0,14,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}"/>
                            <CheckBox Grid.Row="5" Grid.Column="1" x:Name="ChkAutoCheck" IsChecked="True"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Content="Check for updates at startup"
                                      Style="{StaticResource ThemedCheckBox}"
                                      ToolTip="One anonymous call to the GitHub API when the app starts. Turn it off to go online only when you press Check for updates"
                                      Foreground="{DynamicResource FgBrush}"/>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- Barra avanzamento della coda in corso (condivisa da tutte le schede) -->
        <ProgressBar x:Name="Progress" Grid.Row="1" Height="18" Margin="0,8,0,4"
                     Minimum="0" Maximum="100" Value="0"/>

        <!-- Il log resta alto 140px FISSI. Un GridSplitter era stato provato e ritirato: le
             righe che rendeva elastiche lasciavano una fascia vuota fra il riquadro delle
             schede e la barra di avanzamento, e il log e' un pannello di servizio che sta
             bene dove sta. -->
        <TextBlock Grid.Row="2" Text="Log:" Margin="0,4,0,2" FontWeight="Bold"
                   Foreground="{DynamicResource FgBrush}"/>

        <!-- Log (condiviso da tutte le schede) -->
        <TextBox x:Name="TxtLog" Grid.Row="3"
                 IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Background="{DynamicResource CtrlBgBrush}"
                 Foreground="{DynamicResource FgBrush}"
                 BorderBrush="{DynamicResource CtrlBorderBrush}"
                 CaretBrush="{DynamicResource FgBrush}"/>

    </Grid>
</Window>
