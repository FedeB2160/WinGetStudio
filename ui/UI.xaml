<!--
    UI.xaml — finestra principale di WinGet Update Tool.

    Caricato da WinGetUpdateTool.ps1: se questo file esiste accanto allo script/exe vince
    su quello embeddato, quindi si puo' ritoccare la UI e rilanciare senza ricompilare.
    build.ps1 lo inietta nell'exe per mantenerlo single-file.

    I colori arrivano da Theme.Light.xaml / Theme.Dark.xaml, montati a runtime in
    Resources.MergedDictionaries. Usare SEMPRE {DynamicResource ...} per i colori:
    StaticResource si risolve una volta sola e non seguirebbe il cambio tema.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinGet Update Tool" Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource FgBrush}">

    <Window.Resources>
        <!-- Spinner riutilizzabile: 8 punti con opacita' decrescente, rotazione a
             8 step in 1s (equivalente WPF dell'esempio CSS). -->
        <Style x:Key="Spinner" TargetType="Control">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Viewbox>
                            <Canvas Width="48" Height="48">
                                <Canvas.RenderTransform>
                                    <RotateTransform CenterX="24" CenterY="24" Angle="0"/>
                                </Canvas.RenderTransform>
                                <!-- Animazione auto-targettata (nessun TargetName: evita la
                                     risoluzione nella namescope del template, che fallisce). -->
                                <Canvas.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimationUsingKeyFrames
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        Duration="0:0:1">
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.125" Value="45"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.250" Value="90"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.375" Value="135"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.500" Value="180"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.625" Value="225"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.750" Value="270"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.875" Value="315"/>
                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.000" Value="360"/>
                                                </DoubleAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Canvas.Triggers>
                                <Ellipse Canvas.Left="35.5" Canvas.Top="20.5" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="1.0"/>
                                <Ellipse Canvas.Left="31.1" Canvas.Top="31.1" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.85"/>
                                <Ellipse Canvas.Left="20.5" Canvas.Top="35.5" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.7"/>
                                <Ellipse Canvas.Left="9.9"  Canvas.Top="31.1" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.55"/>
                                <Ellipse Canvas.Left="5.5"  Canvas.Top="20.5" Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.4"/>
                                <Ellipse Canvas.Left="9.9"  Canvas.Top="9.9"  Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.3"/>
                                <Ellipse Canvas.Left="20.5" Canvas.Top="5.5"  Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.2"/>
                                <Ellipse Canvas.Left="31.1" Canvas.Top="9.9"  Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Opacity="0.12"/>
                            </Canvas>
                        </Viewbox>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pulsanti: template minimo. Quello di sistema (Aero2) ha hover/pressed cablati
             su gradienti chiari e in Dark-Mode tornerebbe azzurro sotto il mouse. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CtrlBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CtrlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CtrlPressBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource SubtleFgBrush}"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header DataGrid: anche qui template minimo, DataGridHeaderBorder di sistema
             disegna il gradiente Aero e ignora Background. -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{DynamicResource HeaderBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="0,0,1,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ponytail: la CheckBox tiene il template di sistema, si ricolora solo la cornice.
             In Dark-Mode il quadratino non spuntato resta chiarino: ri-templarla solo se da'
             davvero fastidio. -->
        <Style x:Key="GridCheckBox" TargetType="CheckBox">
            <Setter Property="Background" Value="{DynamicResource CtrlBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource CtrlBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                            <Grid>
                                <!-- PART_Track / PART_Indicator: nomi richiesti da ProgressBar
                                     per calcolare la larghezza dell'indicatore. -->
                                <Rectangle x:Name="PART_Track"/>
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 top bar -->
            <RowDefinition Height="*"/>      <!-- 1 elenco -->
            <RowDefinition Height="Auto"/>   <!-- 2 action bar -->
            <RowDefinition Height="Auto"/>   <!-- 3 progress -->
            <RowDefinition Height="Auto"/>   <!-- 4 log label -->
            <RowDefinition Height="140"/>    <!-- 5 log -->
        </Grid.RowDefinitions>

        <!-- Top bar: ricerca + conteggio disponibili + selettore tema -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="BtnRefresh" Content="Cerca aggiornamenti" Width="140" Height="30" DockPanel.Dock="Left"/>
            <Control x:Name="TopSpinner" Width="20" Height="20" Style="{StaticResource Spinner}"
                     DockPanel.Dock="Left" Margin="10,0,0,0" Visibility="Collapsed"/>
            <!-- Pulsante ciclico Chiaro -> Scuro -> Auto. Glifo e ToolTip li scrive lo script.
                 Icone dal set di sistema (Segoe Fluent Icons, fallback Segoe MDL2 Assets). -->
            <Button x:Name="BtnTheme" Width="36" Height="30" DockPanel.Dock="Right"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
            <TextBlock x:Name="TxtAvailable" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
        </DockPanel>

        <!-- Tabella upgrade -->
        <DataGrid x:Name="Grid" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  IsReadOnly="False" SelectionMode="Extended"
                  Background="{DynamicResource BgBrush}"
                  Foreground="{DynamicResource FgBrush}"
                  BorderBrush="{DynamicResource BorderBrush2}"
                  RowBackground="{DynamicResource BgBrush}"
                  AlternatingRowBackground="{DynamicResource RowAltBgBrush}"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush2}"
                  ColumnHeaderStyle="{StaticResource GridHeader}"
                  CellStyle="{StaticResource GridCell}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Width="40"
                    ElementStyle="{StaticResource GridCheckBox}"
                    EditingElementStyle="{StaticResource GridCheckBox}"
                    Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Nome"                 Width="2*"   IsReadOnly="True" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Versione installata"  Width="1.2*" IsReadOnly="True" Binding="{Binding Version}"/>
                <DataGridTextColumn Header="Versione disponibile" Width="1.2*" IsReadOnly="True" Binding="{Binding Available}"/>
                <DataGridTextColumn Header="ID"                   Width="2*"   IsReadOnly="True" Binding="{Binding Id}"/>
                <!-- Esito: spinner (in corso) oppure glyph colorato -->
                <DataGridTemplateColumn Header="Esito" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" ToolTip="{Binding StatusDetail}">
                                <Control x:Name="cellSpinner" Width="18" Height="18"
                                         Style="{StaticResource Spinner}" Visibility="Collapsed"/>
                                <!-- Icone di stato dal set di sistema di Windows 11 (fallback a
                                     Segoe MDL2 Assets su Win10): forme PIENE e distinte fra loro,
                                     leggibili anche senza distinguere i colori. Niente FontWeight:
                                     un icon font in Bold viene ingrassato per sintesi e sbava. -->
                                <TextBlock x:Name="cellIcon" FontSize="16"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="updating">
                                    <Setter TargetName="cellSpinner" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <!-- EC61 CompletedSolid: cerchio pieno con spunta bianca -->
                                <DataTrigger Binding="{Binding Status}" Value="ok">
                                    <Setter TargetName="cellIcon" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="cellIcon" Property="Text" Value="&#xEC61;"/>
                                    <Setter TargetName="cellIcon" Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                </DataTrigger>
                                <!-- EB90 StatusErrorFull: cerchio pieno con X bianca -->
                                <DataTrigger Binding="{Binding Status}" Value="error">
                                    <Setter TargetName="cellIcon" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="cellIcon" Property="Text" Value="&#xEB90;"/>
                                    <Setter TargetName="cellIcon" Property="Foreground" Value="{DynamicResource ErrBrush}"/>
                                </DataTrigger>
                                <!-- E814 IncidentTriangle: triangolo pieno con ! bianco -->
                                <DataTrigger Binding="{Binding Status}" Value="warning">
                                    <Setter TargetName="cellIcon" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="cellIcon" Property="Text" Value="&#xE814;"/>
                                    <Setter TargetName="cellIcon" Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Messaggio "nessun aggiornamento" (nascosto di default) -->
        <TextBlock x:Name="TxtEmpty" Grid.Row="1"
                   Text="Nessun aggiornamento disponibile."
                   FontSize="16" Foreground="{DynamicResource SubtleFgBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- Action bar: selezione + aggiorna + conteggio selezionati -->
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button x:Name="BtnToggleAll" Content="Seleziona tutto" Width="140" Height="30"
                    DockPanel.Dock="Left" IsEnabled="False"/>
            <Button x:Name="BtnUpdate" Content="Aggiorna" Width="140" Height="30"
                    DockPanel.Dock="Left" Margin="8,0,0,0" IsEnabled="False"/>
            <TextBlock x:Name="TxtSelected" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource SubtleFgBrush}"/>
        </DockPanel>

        <!-- Barra avanzamento coda aggiornamenti -->
        <ProgressBar x:Name="Progress" Grid.Row="3" Height="18" Margin="0,8,0,4"
                     Minimum="0" Maximum="100" Value="0"/>

        <TextBlock Grid.Row="4" Text="Log:" Margin="0,4,0,2" FontWeight="Bold"
                   Foreground="{DynamicResource FgBrush}"/>

        <!-- Log -->
        <TextBox x:Name="TxtLog" Grid.Row="5"
                 IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Background="{DynamicResource CtrlBgBrush}"
                 Foreground="{DynamicResource FgBrush}"
                 BorderBrush="{DynamicResource BorderBrush2}"
                 CaretBrush="{DynamicResource FgBrush}"/>
    </Grid>
</Window>
