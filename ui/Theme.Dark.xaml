<!--
    Theme.Dark.xaml — palette scura (tinte Windows 11 dark).
    Stesse chiavi di Theme.Light.xaml: cambiare solo i colori, mai i nomi.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BgBrush"          Color="#202020"/>  <!-- sfondo finestra -->
    <SolidColorBrush x:Key="FgBrush"          Color="#FFFFFF"/>  <!-- testo principale -->
    <SolidColorBrush x:Key="SubtleFgBrush"    Color="#A0A0A0"/>  <!-- testo secondario -->
    <SolidColorBrush x:Key="CtrlBgBrush"      Color="#2D2D2D"/>  <!-- superficie dei controlli -->
    <SolidColorBrush x:Key="CtrlHoverBrush"   Color="#3A3A3A"/>  <!-- hover pulsanti -->
    <SolidColorBrush x:Key="CtrlPressBrush"   Color="#454545"/>  <!-- pulsante premuto -->
    <SolidColorBrush x:Key="BorderBrush2"     Color="#3D3D3D"/>  <!-- gridline e cornici della griglia -->
    <!-- Confine dei componenti interattivi: 2.84:1 sulla pagina, 2.40:1 sul controllo. Sotto
         il 3:1 di WCAG 1.4.11, e la scelta e' deliberata: su fondo scuro la separazione la
         fa il passo di superficie (#2D2D2D su #202020), e un bordo a 3:1 qui diventerebbe un
         contorno marcato che Windows 11 stesso non disegna. Resta il triplo del #3D3D3D di
         prima, che era 1.50:1 e non si vedeva. -->
    <SolidColorBrush x:Key="CtrlBorderBrush"  Color="#666666"/>
    <SolidColorBrush x:Key="HeaderBgBrush"    Color="#2B2B2B"/>  <!-- header DataGrid -->
    <SolidColorBrush x:Key="RowAltBgBrush"    Color="#262626"/>  <!-- righe alterne -->
    <SolidColorBrush x:Key="SelBgBrush"       Color="#0F3A5C"/>  <!-- riga selezionata -->
    <SolidColorBrush x:Key="AccentBrush"      Color="#4CC2FF"/>  <!-- spinner, progress -->
    <!-- NON bianco: l'accento scuro e' azzurro chiaro e il bianco sopra faceva 2.01:1. -->
    <SolidColorBrush x:Key="AccentFgBrush"    Color="#00243A"/>  <!-- testo sopra AccentBrush: 7.97:1 -->
    <SolidColorBrush x:Key="OkBrush"          Color="#6CCB5F"/>  <!-- esito ok -->
    <SolidColorBrush x:Key="WarnBrush"        Color="#FCE100"/>  <!-- esito avviso -->
    <SolidColorBrush x:Key="ErrBrush"         Color="#FF99A4"/>  <!-- esito errore -->

</ResourceDictionary>
