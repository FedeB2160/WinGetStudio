<Project Sdk="Microsoft.NET.Sdk">

  <!-- xUnit v3 su Microsoft.Testing.Platform (attivato in global.json): niente VSTest. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- xUnit1051: i test della coda girano in millisecondi su un winget finto; il token del
         test servirebbe solo ad annullare prima, e il test dell'annullamento usa il suo. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinGetStudio.Core\WinGetStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
