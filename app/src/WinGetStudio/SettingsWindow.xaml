<Window x:Class="WinGetStudio.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinGetStudio"
        Title="Settings" Width="880" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        AutomationProperties.HelpText="Theme, tab strip, startup, version and updates">
    <!-- Settings come finestra modale sopra la principale (ADR 0028): una card per area, compatte.
         Gli esiti e le note vanno a capo su una riga loro, piu' piccoli, e spariscono se vuoti. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CompactCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="14,10"/>
            </Style>
            <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}">
                <Setter Property="Margin" Value="2,14,0,6"/>
            </Style>
            <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <!-- Due colonne: le impostazioni crescono in larghezza, non in altezza. -->
    <Grid Margin="16,8,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
        <TextBlock Text="Appearance" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource CompactCard}">
            <!-- Etichette a larghezza automatica: una piu' lunga non rompe l'allineamento. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Theme" Style="{StaticResource Label}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox Width="150" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                              AutomationProperties.Name="Theme"/>
                    <TextBlock Style="{StaticResource Hint}" FontSize="12" Text="{Binding ThemeHint}"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Tab strip" Style="{StaticResource Label}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                          ItemsSource="{Binding TabStyles}" SelectedItem="{Binding SelectedTabStyle}"
                          AutomationProperties.Name="Tab strip" ToolTip="What the tabs show: the icon, the name, or both"/>
            </Grid>
        </Border>

        <!-- Avvio con Windows: la voce Run dell'utente. Spenta in una build di sviluppo. -->
        <TextBlock Text="Startup" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource CompactCard}">
            <StackPanel>
                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanStartWithWindows}"
                          ToolTip="Open WinGet Studio when you sign in to Windows (a Run entry for your account only)"/>
                <TextBlock Style="{StaticResource Note}" Text="{Binding StartWithWindowsHint}"/>
                <!-- Always start as administrator (ADR 0024): un UAC a ogni apertura. Spenta nel
                     portable, con la nota che dice perche'. -->
                <CheckBox Content="Always start as administrator" Margin="0,10,0,0" IsChecked="{Binding StartElevated}" IsEnabled="{Binding CanToggleStartElevated}"
                          ToolTip="One Windows prompt when WinGet Studio opens, instead of one per installer. Turning it on needs the app running as administrator; turning it off offers to restart now"/>
                <TextBlock Style="{StaticResource Note}" Text="{Binding StartElevatedHint}"/>
                <!-- Una tantum (ADR 0024): sparisce da elevata e nel portable, dove la nota dice perche'. -->
                <Button Style="{StaticResource PageButton}" Padding="11,5,11,6" Margin="0,10,0,0" HorizontalAlignment="Left" Tag="&#xEA18;"
                        Content="Restart as administrator" Command="{Binding RestartElevatedCommand}"
                        Visibility="{Binding CanRestartElevated, Converter={StaticResource Visible}}"
                        ToolTip="Close WinGet Studio and open it again as administrator, after one Windows prompt"/>
            </StackPanel>
        </Border>

        </StackPanel>

        <StackPanel Grid.Column="2">
        <TextBlock Text="Updates" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource CompactCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Una voce per riga: versione e pulsante (solo con una versione piu' recente), sotto
                     l'esito del controllo. -->
                <TextBlock Text="WinGet Studio" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,16,0"/>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" MinHeight="32">
                        <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Style="{StaticResource AccentButtonStyle}" Content="{Binding UpdateAppText}" ToolTip="{Binding UpdateAppToolTip}"
                                Command="{Binding UpdateAppCommand}" Visibility="{Binding UpdateAppVisible, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}" Text="{Binding UpdateStatus}"/>
                </StackPanel>
                <!-- winget stesso (ADR 0019): chi lo aggiorna, o il pulsante. -->
                <TextBlock Grid.Row="2" Text="winget" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,16,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <StackPanel Orientation="Horizontal" MinHeight="32">
                        <TextBlock Text="{Binding WinGetVersionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button Style="{StaticResource AccentButtonStyle}" Content="{Binding UpdateWinGetText}" ToolTip="{Binding UpdateWinGetToolTip}"
                                Command="{Binding UpdateWinGetCommand}" Visibility="{Binding UpdateWinGetVisible, Converter={StaticResource Visible}}"/>
                        <TextBlock Style="{StaticResource Subtle}" VerticalAlignment="Center"
                                   Visibility="{Binding WinGetStore, Converter={StaticResource Visible}}">Updated by the <Hyperlink
                                   NavigateUri="ms-windows-store://downloadsandupdates">Microsoft Store</Hyperlink></TextBlock>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Note}" Text="{Binding WinGetStatus}"/>
                </StackPanel>
                <!-- Valgono per tutte e due le voci sopra. -->
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button Content="Check for updates" MinWidth="140" Command="{Binding CheckForUpdatesCommand}"/>
                    <CheckBox Content="Check at startup" Margin="16,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding CheckAtStartup}"
                              ToolTip="Anonymous calls to the GitHub API when the app starts: one for WinGet Studio, and one for winget where the Microsoft Store does not update it. Turn it off to go online only when you press Check for updates"/>
                    <local:Spinner Margin="12,0,0,0" Visibility="{Binding Checking, Converter={StaticResource Visible}}"/>
                </StackPanel>
            </Grid>
        </Border>

        </StackPanel>

        <!-- Esc chiude: e' il pulsante di annullamento. -->
        <Button Grid.Row="1" Grid.ColumnSpan="3" Content="Close" IsCancel="True" MinWidth="96" HorizontalAlignment="Right" Margin="0,14,0,0"/>
    </Grid>
</Window>
