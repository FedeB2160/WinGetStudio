<Window x:Class="WinGetStudio.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinGetStudio"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Settings" Width="760" Height="460" ResizeMode="NoResize" ShowInTaskbar="False" FontSize="{DynamicResource BaseFontSize}"
        AutomationProperties.HelpText="Theme, tab strip, startup, notification area, version and updates">
    <!-- Settings come finestra modale sopra la principale (ADR 0028): un menu a sinistra, una pagina
         per sezione a destra, tutte nella stessa finestra a misura fissa. Si apre sempre sulla prima.
         Gli esiti e le note vanno a capo su una riga loro, piu' piccoli, e spariscono se vuoti. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CompactCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="14,10"/>
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="2,0,0,16"/>
            </Style>
            <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Una pagina e' visibile solo quando la sua voce (Tag = indice) e' quella scelta nel menu. -->
            <Style x:Key="Page" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Value="True">
                        <DataTrigger.Binding>
                            <MultiBinding Converter="{x:Static local:SettingsWindow.SameIndex}">
                                <Binding Path="SelectedIndex" ElementName="Nav"/>
                                <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                            </MultiBinding>
                        </DataTrigger.Binding>
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu: glifo (Tag) e nome, come le Impostazioni di Windows 11; la voce scelta ha lo sfondo
             del ListBoxItem Fluent e una barretta nel colore accento. Frecce su e giu' per muoversi.
             Il pulsante in alto lo comprime alle sole icone (NavCompact, non salvato). -->
        <DockPanel Margin="8,8,8,12">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Width" Value="184"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NavCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Width" Value="48"/>
                        </DataTrigger>
                        <!-- Scorre in 150 ms, solo con le animazioni di Windows accese (altrimenti scatta). -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding NavCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="48" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="184" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Width="40" Height="36" Padding="0" Margin="4,0,0,4"
                    Background="Transparent" BorderThickness="0" Click="NavToggle_Click"
                    AutomationProperties.Name="Show or hide section names" ToolTip="Show or hide section names">
                <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Text="&#xE700;"/>
            </Button>
        <ListBox x:Name="Nav" SelectedIndex="0" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Settings sections">
            <!-- Voce scelta con uno sfondo tenue e il testo normale, come le Impostazioni di Windows:
                 il ListBoxItem Fluent la riempie di accento. Stesse chiavi che il suo template legge. -->
            <ListBox.Resources>
                <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="{DynamicResource SubtleFillColorSecondary}"/>
                <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="{DynamicResource SubtleFillColorTertiary}"/>
                <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressedThemeBrush" Color="{DynamicResource SubtleFillColorTertiary}"/>
                <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{DynamicResource TextFillColorPrimary}"/>
            </ListBox.Resources>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                    <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <Grid>
                                    <Border Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-10,0,0,0"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource Visible}}"/>
                                    <!-- Altezza fissa: senza il nome la voce si abbassava e le icone salivano. -->
                                    <StackPanel Orientation="Horizontal" Margin="4,2" Height="20">
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NavCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBoxItem Content="Appearance" Tag="&#xE790;"/>
            <ListBoxItem Content="General" Tag="&#xE713;"/>
            <ListBoxItem Content="Updates" Tag="&#xE895;"/>
        </ListBox>
        </DockPanel>
        <!-- Linea fra il menu e la pagina: lo stesso tratto delle aree. -->
        <Border Width="1" HorizontalAlignment="Right" Margin="0,12" Background="{DynamicResource AreaStrokeBrush}"/>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
            <Grid>
                <!-- Appearance -->
                <StackPanel Style="{StaticResource Page}">
                    <StackPanel.Tag><sys:Int32>0</sys:Int32></StackPanel.Tag>
                    <TextBlock Text="Appearance" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource CompactCard}">
                        <!-- Etichette a larghezza automatica: una piu' lunga non rompe l'allineamento. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Theme" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Column="1" Width="150" HorizontalAlignment="Left" ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme}" AutomationProperties.Name="Theme"/>
                            <TextBlock Grid.Row="2" Text="Tab strip" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                                      ItemsSource="{Binding TabStyles}" SelectedItem="{Binding SelectedTabStyle}"
                                      AutomationProperties.Name="Tab strip" ToolTip="What the tabs show: the icon, the name, or both"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- General: avvio e area di notifica. -->
                <StackPanel Style="{StaticResource Page}">
                    <StackPanel.Tag><sys:Int32>1</sys:Int32></StackPanel.Tag>
                    <TextBlock Text="General" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource CompactCard}">
                        <StackPanel>
                            <!-- Avvio con Windows: la voce Run dell'utente. Spenta in una build di sviluppo. -->
                            <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanStartWithWindows}"
                                      ToolTip="Open WinGet Studio when you sign in to Windows (a Run entry for your account only)"/>
                            <TextBlock Style="{StaticResource Note}" Text="{Binding StartWithWindowsHint}"/>
                            <!-- Always start as administrator (ADR 0024): un UAC a ogni apertura. Spenta nel
                                 portable, con la nota che dice perche'. -->
                            <CheckBox Content="Always start as administrator" Margin="0,10,0,0" IsChecked="{Binding StartElevated}" IsEnabled="{Binding CanToggleStartElevated}"
                                      ToolTip="One Windows prompt when WinGet Studio opens, instead of one per installer. Turning it on needs the app running as administrator; turning it off offers to restart now"/>
                            <TextBlock Style="{StaticResource Note}" Text="{Binding StartElevatedHint}"/>
                            <!-- Una tantum (ADR 0024): sparisce da elevata e nel portable, dove la nota dice perche'. -->
                            <Button Style="{StaticResource PageButton}" Padding="11,5,11,6" Margin="0,10,0,0" HorizontalAlignment="Left" Tag="&#xEA18;"
                                    Content="Restart as administrator" Command="{Binding RestartElevatedCommand}"
                                    Visibility="{Binding CanRestartElevated, Converter={StaticResource Visible}}"
                                    ToolTip="Close WinGet Studio and open it again as administrator, after one Windows prompt"/>
                        </StackPanel>
                    </Border>
                    <!-- Area di notifica (ADR 0030): la X che nasconde e il controllo periodico. -->
                    <Border Style="{StaticResource CompactCard}" Margin="0,12,0,0">
                        <StackPanel>
                            <CheckBox Content="Close to tray" IsChecked="{Binding CloseToTray}"
                                      ToolTip="The close button hides the window and WinGet Studio keeps running in the notification area. Close in the icon's menu closes it"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Check for package updates" Style="{StaticResource Label}"/>
                                <ComboBox Width="150" ItemsSource="{Binding CheckIntervals}" SelectedItem="{Binding SelectedCheckInterval}"
                                          AutomationProperties.Name="Check for package updates"
                                          ToolTip="Look for package updates in the background while WinGet Studio runs, never over another winget operation. New updates show a notification when the window is not in front"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Updates: WinGet Studio e winget stesso. -->
                <StackPanel Style="{StaticResource Page}">
                    <StackPanel.Tag><sys:Int32>2</sys:Int32></StackPanel.Tag>
                    <TextBlock Text="Updates" Style="{StaticResource PageTitle}"/>
                    <Border Style="{StaticResource CompactCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Una voce per riga: versione e pulsante (solo con una versione piu' recente), sotto
                                 l'esito del controllo. -->
                            <TextBlock Text="WinGet Studio" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,16,0"/>
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal" MinHeight="32">
                                    <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Button Style="{StaticResource AccentButtonStyle}" Content="{Binding UpdateAppText}" ToolTip="{Binding UpdateAppToolTip}"
                                            Command="{Binding UpdateAppCommand}" Visibility="{Binding UpdateAppVisible, Converter={StaticResource Visible}}"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Note}" Text="{Binding UpdateStatus}"/>
                            </StackPanel>
                            <!-- winget stesso (ADR 0019): chi lo aggiorna, o il pulsante. -->
                            <TextBlock Grid.Row="2" Text="winget" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,16,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <StackPanel Orientation="Horizontal" MinHeight="32">
                                    <TextBlock Text="{Binding WinGetVersionText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Button Style="{StaticResource AccentButtonStyle}" Content="{Binding UpdateWinGetText}" ToolTip="{Binding UpdateWinGetToolTip}"
                                            Command="{Binding UpdateWinGetCommand}" Visibility="{Binding UpdateWinGetVisible, Converter={StaticResource Visible}}"/>
                                    <TextBlock Style="{StaticResource Subtle}" VerticalAlignment="Center"
                                               Visibility="{Binding WinGetStore, Converter={StaticResource Visible}}">Updated by the <Hyperlink
                                               NavigateUri="ms-windows-store://downloadsandupdates">Microsoft Store</Hyperlink></TextBlock>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Note}" Text="{Binding WinGetStatus}"/>
                            </StackPanel>
                            <!-- Valgono per tutte e due le voci sopra. -->
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <Button Content="Check for updates" MinWidth="140" Command="{Binding CheckForUpdatesCommand}"/>
                                <CheckBox Content="Check at startup" Margin="16,0,0,0" VerticalAlignment="Center"
                                          IsChecked="{Binding CheckAtStartup}"
                                          ToolTip="Anonymous calls to the GitHub API when the app starts: one for WinGet Studio, and one for winget where the Microsoft Store does not update it. Turn it off to go online only when you press Check for updates"/>
                                <local:Spinner Margin="12,0,0,0" Visibility="{Binding Checking, Converter={StaticResource Visible}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Fascia in basso come nei dialoghi. Esc chiude: e' il pulsante di annullamento. -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{DynamicResource AreaStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <Button Content="Close" IsCancel="True" MinWidth="96" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Window>
