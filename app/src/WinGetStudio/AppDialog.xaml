<Window x:Class="WinGetStudio.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinGetStudio.ViewModels"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        MinWidth="360" MaxWidth="560" FontSize="{DynamicResource BaseFontSize}">
    <!-- Dialogo dell'app (ADR 0020): finestra modale col tema Fluent di ThemeMode (ADR 0027). -->
    <Window.Resources>
      <ResourceDictionary>
        <!-- Dimensioni del testo uguali alle altre finestre (BaseFontSize). -->
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Styles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="Visible"/>
        <!-- Anteprima dell'import: spunta, Id, sorgente, versione. Larghezze FISSE: il dialogo
             prende la misura del contenuto, e una colonna a '*' non avrebbe spazio da dividere. -->
        <DataTemplate DataType="{x:Type vm:ImportPreviewViewModel}">
            <StackPanel Margin="0,12,0,0">
                <DataGrid ItemsSource="{Binding Rows}" MaxHeight="260" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <!-- Seleziona tutto come nelle griglie principali (SelectAllHeader, Styles.xaml). -->
                        <DataGridTemplateColumn Width="44" HeaderTemplate="{StaticResource SelectAllHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" MinWidth="0"
                                              HorizontalAlignment="Center" AutomationProperties.Name="Import"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Package ID" Width="200" Binding="{Binding Id}"/>
                        <DataGridTextColumn Header="Source" Width="90" Binding="{Binding Source}"/>
                        <!-- Senza versione nel file (l'export dell'app non la salva) winget installa l'ultima: lo si dice. -->
                        <DataGridTemplateColumn Header="Version" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="version" Text="{Binding Version}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Version}" Value="">
                                            <Setter TargetName="version" Property="Text" Value="latest"/>
                                            <Setter TargetName="version" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Setter TargetName="version" Property="ToolTip" Value="No version in the file: winget installs the latest"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- Spenta: si sceglie di riapplicare gli argomenti salvati, non di toglierli. -->
                <CheckBox Margin="0,10,0,0" IsChecked="{Binding KeepStoredArguments}"
                          Visibility="{Binding HasStoredArguments, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding KeepStoredText}" TextWrapping="Wrap" MaxWidth="380"/>
                </CheckBox>
            </StackPanel>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="20,20,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DlgIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                       Margin="0,0,16,0" VerticalAlignment="Top" Visibility="Collapsed"/>
            <!-- Il testo si seleziona e si copia: un TextBox in sola lettura (o un RichTextBox
                 coi link, aggiunto dal codice). -->
            <StackPanel x:Name="DlgBody" Grid.Column="1" VerticalAlignment="Center">
                <TextBox x:Name="DlgText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="480" TextBlock.LineHeight="18"
                         VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0"/>
                <ContentControl x:Name="DlgContent" Focusable="False"/>
            </StackPanel>
        </Grid>
        <!-- Fascia dei pulsanti staccata dal testo, come nella 1.12: sfondo di un tono diverso e una
             riga sopra. -->
        <Border Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{DynamicResource AreaStrokeBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel x:Name="DlgButtons" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Window>
