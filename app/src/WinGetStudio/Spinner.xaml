<!-- Spinner di caricamento, come nella 1.x: un arco che gira, nel colore accento di Fluent. Un
     disegno proprio e non un controllo ri-templato (ADR 0027, ADR 0028). Gira solo se visibile. -->
<UserControl x:Class="WinGetStudio.Spinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="18" Height="18" VerticalAlignment="Center" Focusable="False"
             AutomationProperties.Name="Working">
    <!-- Circonferenza (18 - 2.5) * pi = 48.7 px, 19.5 spessori: tre quarti di arco. -->
    <Ellipse x:Name="Arc" StrokeThickness="2.5" StrokeDashArray="14.5 5" StrokeDashCap="Round"
             Stroke="{DynamicResource AccentFillColorDefaultBrush}" RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform>
            <RotateTransform x:Name="Turn"/>
        </Ellipse.RenderTransform>
    </Ellipse>
</UserControl>
