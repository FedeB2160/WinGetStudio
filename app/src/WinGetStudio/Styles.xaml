<!-- Stili condivisi dalle finestre: solo spazi, testo e chiavi Fluent, nessun colore ne' template
     propri (ADR 0027, ADR 0028). Unito nelle Resources di ogni finestra e non in App.xaml: lo
     smoke test apre le finestre con un'Application sua. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:local="clr-namespace:WinGetStudio">
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <!-- Testo di tutte le finestre (FontSize della Window, ereditato): uno solo, non i 14 di
         Fluent in alcune e un altro valore nelle schede. Intestazioni di colonna e note allo stesso
         valore (CaptionFontSize, per poterle separare); i titoli di sezione un gradino sopra. -->
    <sys:Double x:Key="BaseFontSize">12</sys:Double>
    <sys:Double x:Key="CaptionFontSize">12</sys:Double>
    <sys:Double x:Key="SectionFontSize">14</sys:Double>
    <sys:Double x:Key="ListRowHeight">28</sys:Double>

    <!-- Un'area della finestra: sfondo e bordo delle card di Windows 11. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AreaStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SectionFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="2,0,0,8"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>
    <Style x:Key="Subtle" TargetType="TextBlock">
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
        <!-- "3 selected", "5 packages": il lettore di schermo lo legge quando cambia. -->
        <Setter Property="local:LiveRegion.Announce" Value="True"/>
    </Style>
    <!-- Seleziona tutto, nell'intestazione della colonna delle spunte di ogni griglia: spenta,
         tutte, alcune (indeterminata); quali righe tocca lo decide la scheda (Selectable).
         In Styles.xaml perche' la usa anche l'anteprima dell'import, che non ha State: per questo
         i setter di RowCheck sono scritti qui. In un template e non come Header diretto: un controllo messo li' viene legato
         prima di entrare nell'albero e non trova la griglia. -->
    <DataTemplate x:Key="SelectAllHeader">
        <!-- 7 px a destra: l'intestazione Fluent tiene a destra lo spazio della freccia di
             ordinamento anche nascosta, e la spunta finiva a sinistra di quelle sotto. Un
             margine non ci sta nella colonna stretta: si sposta solo il disegno. -->
        <CheckBox MinWidth="0" MinHeight="0" Padding="0" HorizontalAlignment="Center" AutomationProperties.Name="Select all"
                  ToolTip="Select or clear every package in the list"
                  IsChecked="{Binding DataContext.AllChecked, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                  IsEnabled="{Binding DataContext.CanCheckAll, RelativeSource={RelativeSource AncestorType=DataGrid}}">
            <CheckBox.RenderTransform>
                <TranslateTransform X="7"/>
            </CheckBox.RenderTransform>
        </CheckBox>
    </DataTemplate>

    <!-- Titoli delle colonne a sinistra, dove comincia il testo delle celle (smoke test); al
         centro solo spunta, Pin e Result, le colonne a modello, che non si ordinano. Il
         trigger e' su CanUserSort perche' e' una proprieta' dell'intestazione: Column non
         notifica, e un binding su Column.CanUserResize resta a null. Stile implicito e non
         ColumnHeaderStyle della griglia: col tema Fluent le intestazioni prendono lo stile
         per tipo e ignorano quello. -->
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <!-- Niente separatori verticali: come le righe, solo linee orizzontali. -->
        <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}"/>
        <Setter Property="Padding" Value="3,0,0,0"/>
        <Style.Triggers>
            <Trigger Property="CanUserSort" Value="False">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <!-- Il padding Fluent e' solo a sinistra: spostava la spunta di Seleziona tutto
                     rispetto a quelle delle righe. -->
                <Setter Property="Padding" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Pulsante con glifo (Tag, Segoe Fluent Icons) e nome: Settings e About in alto a destra.
         Basso abbastanza da non toccare il riquadro delle schede. -->
    <Style x:Key="PageButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hover dei pulsanti: quello Fluent nel tema scuro passa dal 6 all'8% di bianco e non si
         vede. Stesse chiavi che il template Fluent legge, ridefinite con colori Fluent piu'
         marcati del tema corrente (le chiavi Color cambiano col tema, ADR 0028). -->
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource ControlStrongStrokeColorDisabled}"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource ControlStrongStrokeColorDefault}" Opacity="0.85"/>

    <!-- Bordo delle aree (card, riquadro delle schede, linguette, griglie) e dei pulsanti: il tratto
         forte del tema corrente, bianco nello scuro e nero nel chiaro, al 55%. Quello Fluent, grigio
         uguale nei due temi, faceva di tutto un blocco unico. -->
    <SolidColorBrush x:Key="AreaStrokeBrush" Color="{DynamicResource ControlStrongStrokeColorDefault}" Opacity="0.55"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource ControlStrongStrokeColorDefault}" Opacity="0.55"/>
    <!-- Linguette non attive: lo stesso tratto, spento. -->
    <SolidColorBrush x:Key="TabStrokeInactiveBrush" Color="{DynamicResource ControlStrongStrokeColorDefault}" Opacity="0.25"/>
</ResourceDictionary>
