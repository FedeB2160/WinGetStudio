<!-- Stili condivisi dalle finestre: solo spazi, testo e chiavi Fluent, nessun colore ne' template
     propri (ADR 0027, ADR 0028). Unito nelle Resources di ogni finestra e non in App.xaml: lo
     smoke test apre le finestre con un'Application sua. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="Visible"/>

    <!-- Un'area della finestra: sfondo e bordo delle card di Windows 11. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="2,0,0,8"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>
    <Style x:Key="Subtle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="12,0,0,0"/>
    </Style>
    <!-- Pulsante con glifo (Tag, Segoe Fluent Icons) e nome: Settings e About in alto a destra.
         Basso abbastanza da non toccare il riquadro delle schede. -->
    <Style x:Key="PageButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hover dei pulsanti: quello Fluent nel tema scuro passa dal 6 all'8% di bianco e non si
         vede. Stesse chiavi che il template Fluent legge, ridefinite con colori Fluent piu'
         marcati del tema corrente (le chiavi Color cambiano col tema, ADR 0028). -->
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource ControlStrongStrokeColorDisabled}"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource SurfaceStrokeColorDefault}"/>
</ResourceDictionary>
