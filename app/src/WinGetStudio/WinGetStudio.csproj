<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- La versione che il self-update confronta col tag dell'ultima release (ADR 0013). -->
    <Version>2.0.0</Version>
    <!-- ThemeMode e' ancora sperimentale in .NET 10 (ADR 0027). -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Icona dell'exe e della finestra, e il logo di About: gli stessi file della 1.x (ADR 0017). -->
  <PropertyGroup>
    <ApplicationIcon>..\..\..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\..\assets\icon\icon-128.png" Link="Assets\icon-128.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinGetStudio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinGetStudio.Core\WinGetStudio.Core.csproj" />
  </ItemGroup>

  <!-- MVVM della finestra (ADR 0023). -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
